<Window x:Class="P2PLocalFileShareServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:P2PLocalFileShareServer.ViewModels"
        xmlns:converters="clr-namespace:P2PLocalFileShareServer.Converters"
        Title="P2P Local File Share Server Pro v2.0"
        Height="850" Width="1380"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <converters:BytesToFormattedSizeConverter x:Key="BytesToSizeConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:ServerStatusToColorConverter x:Key="StatusColorConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentPrimaryBrush}" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#070B10" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="P2P LOCAL FILE SHARE SERVER PRO" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="High-Throughput LAN Distribution &amp; Mobile Web Portal" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Top Quick Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Server Running Indicator -->
                    <Border CornerRadius="20" Padding="12,6" Margin="0,0,16,0" Background="#0F1622" BorderBrush="{Binding IsServerRunning, Converter={StaticResource StatusColorConverter}}" BorderThickness="1.5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{Binding IsServerRunning, Converter={StaticResource StatusColorConverter}}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ServerStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Stats Badges -->
                    <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active Clients: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ActiveSessionCount}" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceCardBrush}" CornerRadius="8" Padding="12,6" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Speed: ⬇ " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding CurrentDownloadSpeedMbps, StringFormat='{}{0:F1} MB/s'}" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="⬆ " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding CurrentUploadSpeedMbps, StringFormat='{}{0:F1} MB/s'}" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (3 Columns) -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <!-- Left: Control & QR Engine -->
                <ColumnDefinition Width="340" />
                <!-- Center: Shared Files & Dropzone -->
                <ColumnDefinition Width="*" />
                <!-- Right: Telemetry & Sessions -->
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <!-- Server Configuration Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Server Configuration" Style="{StaticResource HeaderLabel}" />

                            <!-- Network Adapter Picker -->
                            <TextBlock Text="Network Interface / Adapter" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding NetworkAdapters}"
                                      SelectedItem="{Binding SelectedAdapter}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding IsServerRunning, Converter={StaticResource InverseBoolConverter}}"
                                      Margin="0,0,0,12" Height="36" HorizontalAlignment="Stretch" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Port -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Port Number" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsServerRunning, Converter={StaticResource InverseBoolConverter}}"
                                             Height="36" Padding="8,6" />
                                </StackPanel>

                                <!-- PIN Code -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="4-Digit PIN Code" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding PinCode, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="8" Height="36" Padding="8,6" />
                                </StackPanel>
                            </Grid>

                            <!-- PIN Enable Checkbox -->
                            <CheckBox IsChecked="{Binding IsPinRequired}" Content="Require PIN Authentication for LAN Clients" Margin="0,0,0,16" Foreground="{StaticResource TextPrimaryBrush}" />

                            <!-- Start / Stop Server Big Button -->
                            <Button Command="{Binding ToggleServerCommand}"
                                    Height="44" HorizontalAlignment="Stretch"
                                    FontWeight="Bold" FontSize="14"
                                    BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DangerRedBrush}" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter Property="Content" Value="⛔ STOP P2P SERVER" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}" />
                                                <Setter Property="Foreground" Value="#070B10" />
                                                <Setter Property="Content" Value="▶ START P2P SERVER" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Vector QR Code & LAN Endpoint Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Mobile Scan &amp; Connect" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center" />
                            <TextBlock Text="Scan QR code with phone camera to connect" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-8,0,12" HorizontalAlignment="Center" />

                            <!-- QR Canvas -->
                            <Border Width="220" Height="220" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="2" CornerRadius="12" Padding="8" Margin="0,0,0,12">
                                <Image Source="{Binding QrCodeImage}" Stretch="Uniform" />
                            </Border>

                            <!-- Server LAN URL Display -->
                            <TextBox Text="{Binding ServerUrl, Mode=OneWay}" IsReadOnly="True" TextAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderColorBrush}" Padding="8" Margin="0,0,0,10" Height="36" HorizontalAlignment="Stretch" />

                            <Button Command="{Binding CopyServerUrlCommand}" Content="📋 Copy LAN URL to Clipboard" HorizontalAlignment="Stretch" Height="36" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- CENTER COLUMN -->
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Desktop File Dropzone -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Background="#0F1622" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📥 Shared Desktop Dropzone" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" />
                            <TextBlock Text="Drag &amp; drop files anywhere onto window or click button to add to LAN server" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding AddSharedFilesCommand}" Content="+ Add Files to Share" Height="40" Padding="16,0" Background="{StaticResource AccentPrimaryBrush}" Foreground="#070B10" FontWeight="Bold" BorderThickness="0" />
                    </Grid>
                </Border>

                <!-- Shared Files DataGrid / Table -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Available Shared Files" Style="{StaticResource HeaderLabel}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SharedFiles.Count, StringFormat='{}{0} Item(s)'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SharedFiles}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" RowBackground="{StaticResource BgSecondaryBrush}" AlternatingRowBackground="{StaticResource SurfaceCardBrush}" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderColorBrush}" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,8" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="100" />
                                <DataGridTextColumn Header="Downloads" Binding="{Binding DownloadCount}" Width="90" />
                                <DataGridTemplateColumn Header="Action" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑 Remove" Command="{Binding DataContext.RemoveSharedFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Foreground="{StaticResource DangerRedBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Mobile Upload Destination Folder Picker -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Mobile Client Upload Directory" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding UploadDestinationFolder}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding BrowseUploadFolderCommand}" Content="📁 Change Folder" Height="34" Padding="12,0" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" />
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Speedometer & Gauges -->
                    <RowDefinition Height="Auto" />
                    <!-- Active Sessions -->
                    <RowDefinition Height="180" />
                    <!-- Activity Log Console -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Real-Time Speedometer Gauges -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Real-Time Network Speedometer" Style="{StaticResource HeaderLabel}" />

                        <!-- Download Bar -->
                        <TextBlock Text="Download Throughput (Sent to LAN)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <DockPanel Margin="0,4,0,4">
                            <TextBlock Text="{Binding CurrentDownloadSpeedMbps, StringFormat='{}{0:F2} MB/s'}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" Width="80" TextAlignment="Right" />
                            <ProgressBar Value="{Binding CurrentDownloadSpeedMbps}" Maximum="100" Height="8" Foreground="{StaticResource AccentPrimaryBrush}" Background="{StaticResource BgSecondaryBrush}" BorderThickness="0" />
                        </DockPanel>

                        <!-- Upload Bar -->
                        <TextBlock Text="Upload Throughput (Received from Mobile)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                        <DockPanel Margin="0,4,0,12">
                            <TextBlock Text="{Binding CurrentUploadSpeedMbps, StringFormat='{}{0:F2} MB/s'}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" Width="80" TextAlignment="Right" />
                            <ProgressBar Value="{Binding CurrentUploadSpeedMbps}" Maximum="100" Height="8" Foreground="{StaticResource AccentSecondaryBrush}" Background="{StaticResource BgSecondaryBrush}" BorderThickness="0" />
                        </DockPanel>

                        <Border Background="{StaticResource BgSecondaryBrush}" Padding="8" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total Sent:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TotalBytesSent, Converter={StaticResource BytesToSizeConverter}}" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Total Received:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TotalBytesReceived, Converter={StaticResource BytesToSizeConverter}}" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Active LAN Client Sessions -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Active Client Sessions" Style="{StaticResource HeaderLabel}" Margin="0,0,0,8" />
                        <ListView Grid.Row="1" ItemsSource="{Binding ActiveSessions}" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ActionType}" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" Margin="0,0,6,0" FontSize="11" />
                                                    <TextBlock Text="{Binding ClientIp}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedSpeed}" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding FormattedProgress}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Activity Log Console -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Activity &amp; Security Log Console" Style="{StaticResource HeaderLabel}" Margin="0,0,0,8" />
                        <ListView Grid.Row="1" ItemsSource="{Binding Logs}" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding FormattedTime, StringFormat='[{0}] '}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource HexToBrushConverter}}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock Text="⚡ P2P Local File Share Server Pro 2.0.0 | High-Performance Kestrel Engine | .NET 8.0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                <TextBlock Text="Ready for LAN Connections" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
